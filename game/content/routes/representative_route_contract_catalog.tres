fixed_recovery_amount = 50
minimum_legal_route_count = 2
minimum_legal_loadout_count = 2
tradeoff_dimension_ids = Array[StringName]([&"route.cost.health", &"route.cost.block", &"route.cost.consumable", &"route.cost.detour", &"route.cost.one_time_node", &"route.cost.optional_reward"])
minimum_distinct_tradeoff_dimensions = 2
