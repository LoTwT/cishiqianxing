[resource]
script = ExtResource("1_catalog")
catalog_id = &"progression.global"
initial_stats = SubResource("PlayerStatProfile_initial")
mainline_progression = Array[MainlineProgressionDefinitionResource]([SubResource("MainlineProgression_chapter_01"), SubResource("MainlineProgression_chapter_02"), SubResource("MainlineProgression_chapter_03"), SubResource("MainlineProgression_chapter_04"), SubResource("MainlineProgression_chapter_05"), SubResource("MainlineProgression_chapter_06"), SubResource("MainlineProgression_chapter_07"), SubResource("MainlineProgression_chapter_08"), SubResource("MainlineProgression_chapter_09")])
optional_progression = Array[OptionalProgressionDefinitionResource]([SubResource("OptionalProgression_m01"), SubResource("OptionalProgression_m02"), SubResource("OptionalProgression_m03"), SubResource("OptionalProgression_m04")])
permanent_growth_rewards = Array[PermanentGrowthRewardDefinitionResource]([SubResource("Reward_main_01_maximum_health"), SubResource("Reward_main_01_attack"), SubResource("Reward_main_02_maximum_health"), SubResource("Reward_main_02_defense"), SubResource("Reward_main_03_maximum_health"), SubResource("Reward_main_03_attack"), SubResource("Reward_main_03_defense"), SubResource("Reward_main_04_maximum_health"), SubResource("Reward_main_04_attack"), SubResource("Reward_main_04_defense"), SubResource("Reward_main_04_speed"), SubResource("Reward_main_05_maximum_health"), SubResource("Reward_main_05_attack"), SubResource("Reward_main_05_defense"), SubResource("Reward_main_06_maximum_health"), SubResource("Reward_main_06_attack"), SubResource("Reward_main_06_speed"), SubResource("Reward_main_07_maximum_health"), SubResource("Reward_main_07_defense"), SubResource("Reward_main_07_speed"), SubResource("Reward_main_08_maximum_health"), SubResource("Reward_main_08_attack"), SubResource("Reward_main_08_defense"), SubResource("Reward_main_09_speed"), SubResource("Reward_optional_m01_maximum_health"), SubResource("Reward_optional_m02_attack"), SubResource("Reward_optional_m03_maximum_health"), SubResource("Reward_optional_m03_defense"), SubResource("Reward_optional_m04_attack"), SubResource("Reward_optional_m04_defense")])
